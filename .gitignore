# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
*/.env
**/.auth.env
.geolab_public_demo.env
.last_*
*.pid

# --- Data & generated artifacts (license-bound or large; regenerate via scripts/) ---
soep_metadata_output/
backend/app/data/
**/*.rds
**/*.npy
**/*.faiss
**/*.parquet
*.csv
genesis_metadata/
**/data/indexes/

# --- Logs ---
*.log
logs/
enrichment*.log

# --- Python ---
__pycache__/
*.py[cod]
.cache/
.ipynb_checkpoints/
*.egg-info/
.venv/

# --- Frontend ---
frontend/node_modules/
frontend/dist/
node_modules/
dist/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# build/analysis logs (cruft)
**/build_log*.txt
**/analysis_log.txt
README_SOEP_RAG.md

# --- GeoDB source drop folder ---
# Keep SOURCE.md / source_meta.json / registry (small, describe the sources);
# ignore the downloaded catalogue files themselves (licence-bound, regenerable).
data_sources/*/raw/*
!data_sources/*/raw/.gitkeep

# The source workbook and its pre-annotation copy are working data, not code. The public
# facts they hold (source names, URLs, coverage, status) are published through
# data_sources/registry/geo_sources.json and data_sources/CHECKLIST.md instead.
Geospatial_Data_Sources*.xlsx

# Exported model artefacts (ONNX graphs). Rebuilt by the export step, never committed:
# the repo is code-only and GitHub rejects files over 100 MB anyway.
models/
